# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows-native tooling expects CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Source and documentation.
*.md    text diff=markdown
*.json  text
*.yml   text
*.yaml  text
*.toml  text
*.cpp   text diff=cpp
*.h     text diff=cpp
*.hpp   text diff=cpp
*.cmake text
CMakeLists.txt text

# Papyrus sources are text; compiled scripts are not.
*.psc text
*.pex binary

# Binary game and build assets.
*.dll  binary
*.exe  binary
*.lib  binary
*.pdb  binary
*.esp  binary
*.esm  binary
*.esl  binary
*.bsa  binary
*.nif  binary
*.dds  binary
*.png  binary
*.jpg  binary

# Keep generated lockfiles out of diffs and language statistics.
*.lock linguist-generated=true -diff
