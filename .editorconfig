root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2
# Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{cpp,h,hpp,cmake}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
